# Hugging Face Access Token (任意 / Optional)
# 本リポジトリが使用する Comfy-Org 事前量子化モデルは公開リポジトリのため、
# トークンなし（空欄）でもダウンロードおよび動画生成が完全に動作します。
# 設定した場合、Hugging Face のレート制限（Rate Limit）回避やダウンロード安定化に役立ちます。
# Obtain from https://huggingface.co/settings/tokens (Optional)
HF_TOKEN=

# GCP Configuration (Defaults can be overridden here)
GCP_PROJECT=cloud-execution-environment
GCP_REGION=asia-northeast1
GCP_ZONE=asia-northeast1-b
GCP_INSTANCE_NAME=minimax-h3-l4-spot
GCP_MACHINE_TYPE=g2-standard-8
GCP_DISK_SIZE=150GB
